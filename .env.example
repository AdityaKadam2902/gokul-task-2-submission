# Environment Configuration - LabInsight (Gokul Infocare Task 2)
# Candidate Number: 267

# Application Settings
APP_NAME=LabInsight
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000
API_V1_PREFIX=/api/v1

# CORS Settings (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Settings (Phase 2 Baseline - SQLite)
DATABASE_URL=sqlite:///./backend/data/labinsight.db

# TestWell External Health API (Phase 4A Baseline)
TESTWELL_API_URL=https://www.test-well.com/api/agent/interpret_results
TESTWELL_TIMEOUT_SECONDS=12.0
TESTWELL_MAX_RETRIES=2
TESTWELL_RETRY_BACKOFF_SECONDS=0.5
DEFAULT_UNIT_PROFILE=ASSESSMENT_CONVENTIONAL_V1

# Ollama Local AI (Phase 4B Baseline)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=45.0
OLLAMA_TEMPERATURE=0.1
OLLAMA_MAX_TOKENS=350
OLLAMA_KEEP_ALIVE=5m
